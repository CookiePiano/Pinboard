{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinboard",
  "version": "0.1.0",
  "identifier": "dev.pinboard.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/prepare-installer-ui.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Translucent sticky notes",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "../installer/template.nsi",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "../installer/hooks.nsh",
        "customLanguageFiles": {
          "Korean": "../installer/languages/Korean.nsh",
          "English": "../installer/languages/English.nsh"
        }
      },
      "allowDowngrades": false
    },
    "publisher": "CookiePiano",
    "copyright": "Copyright (c) 2026 CookiePiano",
    "homepage": "https://github.com/CookiePiano/Pinboard",
    "useLocalToolsDir": true
  }
}
