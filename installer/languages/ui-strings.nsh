; Shared native setup/removal copy.
SetFont /LANG=${LANG_KOREAN} "Malgun Gothic" 11
SetFont /LANG=${LANG_ENGLISH} "Segoe UI" 11
LangString pbUiVersion ${LANG_KOREAN} "${VERSION}"
LangString pbUiVersion ${LANG_ENGLISH} "${VERSION}"
LangString pbUiSetup ${LANG_KOREAN} "Pinboard 설치"
LangString pbUiSetup ${LANG_ENGLISH} "Install Pinboard"
LangString pbUiIntro ${LANG_KOREAN} "바탕화면에 붙여 두는 반투명 메모"
LangString pbUiIntro ${LANG_ENGLISH} "Translucent sticky notes, right on your desktop."
LangString pbUiMetadata ${LANG_KOREAN} "${VERSION}  ·  Windows 64-bit"
LangString pbUiMetadata ${LANG_ENGLISH} "${VERSION}  ·  Windows 64-bit"
LangString pbUiPath ${LANG_KOREAN} "설치 위치"
LangString pbUiPath ${LANG_ENGLISH} "Install location"
LangString pbUiBrowse ${LANG_KOREAN} "찾아보기"
LangString pbUiBrowse ${LANG_ENGLISH} "Browse"
LangString pbUiShortcut ${LANG_KOREAN} "바탕화면 바로가기 만들기"
LangString pbUiShortcut ${LANG_ENGLISH} "Create a desktop shortcut"
LangString pbUiLaunch ${LANG_KOREAN} "설치 후 Pinboard 실행"
LangString pbUiLaunch ${LANG_ENGLISH} "Open Pinboard when finished"
LangString pbUiKeep ${LANG_KOREAN} "기존 메모와 설정은 그대로 보관됩니다."
LangString pbUiKeep ${LANG_ENGLISH} "Your existing notes and settings are kept."
LangString pbUiInstall ${LANG_KOREAN} "설치"
LangString pbUiInstall ${LANG_ENGLISH} "Install"
LangString pbUiReinstall ${LANG_KOREAN} "계속"
LangString pbUiReinstall ${LANG_ENGLISH} "Continue"
LangString pbUiExisting ${LANG_KOREAN} "설치된 Pinboard 관리"
LangString pbUiExisting ${LANG_ENGLISH} "Manage your installation"
LangString pbUiManageIntro ${LANG_KOREAN} "설치된 앱에 수행할 작업을 선택하세요."
LangString pbUiManageIntro ${LANG_ENGLISH} "Choose what you would like to do with the installed app."
LangString pbUiInvalidPath ${LANG_KOREAN} "사용할 수 있는 절대 경로를 입력하세요. 드라이브 루트에는 설치할 수 없습니다."
LangString pbUiInvalidPath ${LANG_ENGLISH} "Enter a writable absolute folder path. A drive root cannot be used."
LangString pbUiSpace ${LANG_KOREAN} "설치할 공간이 부족합니다. 다른 위치를 선택하세요."
LangString pbUiSpace ${LANG_ENGLISH} "There is not enough free space. Choose another location."
LangString pbUiInstallProgress ${LANG_KOREAN} "Pinboard 설치 중"
LangString pbUiInstallProgress ${LANG_ENGLISH} "Installing Pinboard"
LangString pbUiWorking ${LANG_KOREAN} "필요한 파일을 준비하고 있습니다. 잠시만 기다려 주세요."
LangString pbUiWorking ${LANG_ENGLISH} "Preparing the files you need. This may take a moment."
LangString pbUiSetupDone ${LANG_KOREAN} "설치를 마쳤습니다"
LangString pbUiSetupDone ${LANG_ENGLISH} "Pinboard is ready"
LangString pbUiSetupDoneText ${LANG_KOREAN} "이제 시작 메뉴에서 Pinboard를 열 수 있습니다."
LangString pbUiSetupDoneText ${LANG_ENGLISH} "You can now open Pinboard from the Start menu."
LangString pbUiDone ${LANG_KOREAN} "마침"
LangString pbUiDone ${LANG_ENGLISH} "Finish"
LangString pbUiClose ${LANG_KOREAN} "닫기"
LangString pbUiClose ${LANG_ENGLISH} "Close"
LangString pbUiRemove ${LANG_KOREAN} "Pinboard 제거"
LangString pbUiRemove ${LANG_ENGLISH} "Uninstall Pinboard"
LangString pbUiRemoveIntro ${LANG_KOREAN} "제거할 앱과 보관할 데이터를 확인하세요."
LangString pbUiRemoveIntro ${LANG_ENGLISH} "Review the app and the data you will keep."
LangString pbUiRemoveAction ${LANG_KOREAN} "제거"
LangString pbUiRemoveAction ${LANG_ENGLISH} "Uninstall"
LangString pbUiInstalledVersion ${LANG_KOREAN} "설치된 버전"
LangString pbUiInstalledVersion ${LANG_ENGLISH} "Installed version"
LangString pbUiRemoveItems ${LANG_KOREAN} "앱과 바로가기를 제거합니다."
LangString pbUiRemoveItems ${LANG_ENGLISH} "The app and its shortcuts will be removed."
LangString pbUiKeepDetail ${LANG_KOREAN} "메모와 설정은 이 PC에 보관됩니다.$\r$\n다시 설치하면 이어서 사용할 수 있습니다."
LangString pbUiKeepDetail ${LANG_ENGLISH} "Your notes and settings stay on this PC.$\r$\nReinstall Pinboard to pick up where you left off."
LangString pbUiRemoveProgress ${LANG_KOREAN} "Pinboard 제거 중"
LangString pbUiRemoveProgress ${LANG_ENGLISH} "Uninstalling Pinboard"
LangString pbUiRemoving ${LANG_KOREAN} "앱과 바로가기를 정리하고 있습니다. 잠시만 기다려 주세요."
LangString pbUiRemoving ${LANG_ENGLISH} "Removing the app and its shortcuts. Please wait."
LangString pbUiRemoveDone ${LANG_KOREAN} "제거를 마쳤습니다"
LangString pbUiRemoveDone ${LANG_ENGLISH} "Pinboard has been removed"
LangString pbUiRemoveDoneText ${LANG_KOREAN} "앱과 바로가기를 제거했습니다."
LangString pbUiRemoveDoneText ${LANG_ENGLISH} "The app and its shortcuts have been removed."
LangString pbUiDataDeleted ${LANG_KOREAN} "선택한 이 PC의 메모와 설정도 삭제했습니다."
LangString pbUiDataDeleted ${LANG_ENGLISH} "The local notes and settings you selected were also deleted."
LangString pbUiMissing ${LANG_KOREAN} "설치된 앱이 없습니다"
LangString pbUiMissing ${LANG_ENGLISH} "Pinboard is not installed"
LangString pbUiMissingText ${LANG_KOREAN} "현재 Windows 계정에서 제거할 Pinboard를 찾지 못했습니다."
LangString pbUiMissingText ${LANG_ENGLISH} "No managed Pinboard installation was found for this account."
LangString pbUiPortable ${LANG_KOREAN} "설치 없이 쓰는 Pinboard.exe는 제거 대상이 아닙니다.$\r$\n아무것도 변경하지 않았습니다."
LangString pbUiPortable ${LANG_ENGLISH} "The portable Pinboard.exe is not managed by this uninstaller.$\r$\nNothing has been changed."
LangString pbUiFailed ${LANG_KOREAN} "작업을 완료하지 못했습니다"
LangString pbUiFailed ${LANG_ENGLISH} "The operation could not finish"
LangString pbUiFailedHelp ${LANG_KOREAN} "아래 세부 정보에서 원인을 확인한 뒤 다시 실행하세요."
LangString pbUiFailedHelp ${LANG_ENGLISH} "Review the details below, then run this wizard again."
LangString pbUiRunning ${LANG_KOREAN} "Pinboard가 실행 중입니다. 트레이에서 종료한 뒤 다시 '제거'를 누르세요."
LangString pbUiRunning ${LANG_ENGLISH} "Pinboard is running. Quit it from the tray, then select Uninstall again."
LangString pbUiCheckFailed ${LANG_KOREAN} "실행 상태를 확인하지 못했습니다. Pinboard를 종료한 뒤 다시 시도하세요."
LangString pbUiCheckFailed ${LANG_ENGLISH} "The running-state check failed. Quit Pinboard and try again."
LangString pbUiDataWarning ${LANG_KOREAN} "아래 항목을 선택하면 이 PC의 메모와 설정도 삭제합니다."
LangString pbUiDataWarning ${LANG_ENGLISH} "Select the option below only to delete your local notes and settings too."
