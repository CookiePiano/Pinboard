SetFont /LANG=${LANG_KOREAN} "Segoe UI" 9
LangString pbHeadingFace ${LANG_KOREAN} "Malgun Gothic"
LangString pbHeadingWeight ${LANG_KOREAN} "700"
LangString pbBrand ${LANG_KOREAN} "Pinboard ${VERSION}"
LangString pbSetupTitle ${LANG_KOREAN} "Pinboard 설치"
LangString pbSetupIntro ${LANG_KOREAN} "바탕화면에 붙여 두는 반투명 메모 앱입니다.$\r$\n$\r$\n현재 Windows 계정에만 설치되므로 관리자 권한이 필요하지 않습니다. 기존 메모와 설정은 그대로 유지됩니다.$\r$\n$\r$\n계속하려면 '다음'을 누르세요."
LangString pbDirectoryIntro ${LANG_KOREAN} "이 폴더에 Pinboard를 설치합니다. 다른 폴더를 쓰려면 '찾아보기'를 누르세요.$\r$\n$\r$\n메모와 설정은 따로 보관되므로 설치 위치와 관계없이 유지됩니다."
LangString pbSetupDoneTitle ${LANG_KOREAN} "설치를 마쳤습니다"
LangString pbSetupDoneText ${LANG_KOREAN} "시작 메뉴에서 언제든 Pinboard를 열 수 있습니다."
LangString pbLaunchApp ${LANG_KOREAN} "Pinboard 열기"
LangString pbUninstallIntro ${LANG_KOREAN} "이 PC에서 Pinboard 앱과 바로가기를 제거합니다. 아래 항목을 선택하지 않으면 메모와 설정은 그대로 보관됩니다."
LangString pbInstalledAt ${LANG_KOREAN} "설치 위치:"
LangString pbUninstallShortcut ${LANG_KOREAN} "${PRODUCTNAME} 제거"
!ifdef PINBOARD_WITH_UNINSTALLER
LangString pbHeaderPathTitle ${LANG_KOREAN} "설치 위치"
LangString pbHeaderPathText ${LANG_KOREAN} "Pinboard를 설치할 폴더를 확인하세요."
LangString pbHeaderProgressTitle ${LANG_KOREAN} "Pinboard를 설치하는 중"
LangString pbHeaderProgressText ${LANG_KOREAN} "잠시만 기다려 주세요."
LangString pbUnHeaderPathTitle ${LANG_KOREAN} "Pinboard 제거"
LangString pbUnHeaderPathText ${LANG_KOREAN} "제거할 항목을 확인하세요."
LangString pbUnHeaderProgressTitle ${LANG_KOREAN} "Pinboard를 제거하는 중"
LangString pbUnHeaderProgressText ${LANG_KOREAN} "잠시만 기다려 주세요."
!else
LangString pbRemoveTitle ${LANG_KOREAN} "Pinboard 제거"
LangString pbRemoveIntro ${LANG_KOREAN} "이 PC에 설치된 Pinboard 앱을 제거합니다.$\r$\n$\r$\n버전: $InstalledVersion$\r$\n위치: $InstallFolder$\r$\n$\r$\n메모와 설정은 그대로 보관됩니다. Pinboard가 열려 있다면 먼저 트레이에서 종료하세요."
LangString pbRemoveAction ${LANG_KOREAN} "제거"
LangString pbRemovingTitle ${LANG_KOREAN} "Pinboard를 제거하는 중"
LangString pbRemovingText ${LANG_KOREAN} "잠시만 기다려 주세요."
LangString pbRemoveDoneTitle ${LANG_KOREAN} "제거를 마쳤습니다"
LangString pbRemoveDoneText ${LANG_KOREAN} "앱과 바로가기를 제거했습니다.$\r$\n$\r$\n메모와 설정은 이 PC에 그대로 있으므로 다시 설치하면 이어서 사용할 수 있습니다. 동기화 폴더와 클라우드의 메모는 변경하지 않았습니다."
LangString pbRemoveFailedTitle ${LANG_KOREAN} "제거하지 못했습니다"
LangString pbRemoveFailedText ${LANG_KOREAN} "Pinboard를 종료한 뒤 다시 시도하세요."
LangString pbRemoveFailed ${LANG_KOREAN} "Pinboard를 제거하지 못했습니다. 앱을 종료한 뒤 다시 시도하세요. 계속 실패하면 Windows 설정의 '설치된 앱'에서 Pinboard를 제거하세요."
LangString pbRemoveRunning ${LANG_KOREAN} "Pinboard가 실행 중입니다.$\r$\n$\r$\n트레이 메뉴에서 Pinboard를 종료한 뒤 '제거'를 다시 누르세요. 실행 중인 앱을 강제로 종료하지 않습니다."
LangString pbPreflightFailed ${LANG_KOREAN} "Pinboard가 실행 중인지 확인할 수 없어 제거를 중단했습니다.$\r$\n$\r$\nPinboard를 종료한 뒤 다시 시도하세요. 아무것도 변경하지 않았습니다."
LangString pbMissingTitle ${LANG_KOREAN} "설치된 Pinboard가 없습니다"
LangString pbMissingText ${LANG_KOREAN} "현재 Windows 계정에 설치된 Pinboard가 없습니다.$\r$\n$\r$\n설치 없이 쓰는 Pinboard.exe는 제거할 필요가 없습니다. 더 이상 쓰지 않으면 파일을 삭제하세요.$\r$\n$\r$\n아무것도 변경하지 않았습니다."
LangString pbClose ${LANG_KOREAN} "닫기"
LangString pbRemoveDetail ${LANG_KOREAN} "등록된 Pinboard 제거 프로그램을 실행합니다."
LangString pbRemovePreserved ${LANG_KOREAN} "완료: 메모, 설정, 동기화 데이터는 보관했습니다."
!endif
