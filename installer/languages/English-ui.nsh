SetFont /LANG=${LANG_ENGLISH} "Segoe UI" 9
LangString pbHeadingFace ${LANG_ENGLISH} "Segoe UI Semibold"
LangString pbHeadingWeight ${LANG_ENGLISH} "600"
LangString pbBrand ${LANG_ENGLISH} "Pinboard ${VERSION}"
LangString pbSetupTitle ${LANG_ENGLISH} "Install Pinboard"
LangString pbSetupIntro ${LANG_ENGLISH} "Translucent sticky notes that stay on your desktop.$\r$\n$\r$\nPinboard installs for your Windows account only, so it does not need administrator rights. Your existing notes and settings are kept.$\r$\n$\r$\nSelect Next to continue."
LangString pbDirectoryIntro ${LANG_ENGLISH} "Pinboard will be installed in this folder. To use a different one, select Browse.$\r$\n$\r$\nYour notes and settings are stored separately and are not affected by this choice."
LangString pbSetupDoneTitle ${LANG_ENGLISH} "Pinboard is ready"
LangString pbSetupDoneText ${LANG_ENGLISH} "You can open Pinboard from the Start menu at any time."
LangString pbLaunchApp ${LANG_ENGLISH} "Open Pinboard"
LangString pbUninstallIntro ${LANG_ENGLISH} "Pinboard and its shortcuts will be removed from this PC. Your notes and settings are kept unless you select the option below."
LangString pbInstalledAt ${LANG_ENGLISH} "Installed in:"
LangString pbUninstallShortcut ${LANG_ENGLISH} "Uninstall ${PRODUCTNAME}"
!ifdef PINBOARD_WITH_UNINSTALLER
LangString pbHeaderPathTitle ${LANG_ENGLISH} "Install location"
LangString pbHeaderPathText ${LANG_ENGLISH} "Confirm the folder for Pinboard."
LangString pbHeaderProgressTitle ${LANG_ENGLISH} "Installing Pinboard"
LangString pbHeaderProgressText ${LANG_ENGLISH} "This takes only a moment."
LangString pbUnHeaderPathTitle ${LANG_ENGLISH} "Uninstall Pinboard"
LangString pbUnHeaderPathText ${LANG_ENGLISH} "Review what will be removed."
LangString pbUnHeaderProgressTitle ${LANG_ENGLISH} "Uninstalling Pinboard"
LangString pbUnHeaderProgressText ${LANG_ENGLISH} "This takes only a moment."
!else
LangString pbRemoveTitle ${LANG_ENGLISH} "Uninstall Pinboard"
LangString pbRemoveIntro ${LANG_ENGLISH} "The installed Pinboard app will be removed from this PC.$\r$\n$\r$\nVersion: $InstalledVersion$\r$\nLocation: $InstallFolder$\r$\n$\r$\nYour notes and settings are kept. If Pinboard is open, quit it from the tray first."
LangString pbRemoveAction ${LANG_ENGLISH} "Uninstall"
LangString pbRemovingTitle ${LANG_ENGLISH} "Uninstalling Pinboard"
LangString pbRemovingText ${LANG_ENGLISH} "This takes only a moment."
LangString pbRemoveDoneTitle ${LANG_ENGLISH} "Pinboard has been removed"
LangString pbRemoveDoneText ${LANG_ENGLISH} "The app and its shortcuts are gone.$\r$\n$\r$\nYour notes and settings are still on this PC, so reinstalling Pinboard brings them back. Your sync folder and cloud notes were not changed."
LangString pbRemoveFailedTitle ${LANG_ENGLISH} "Pinboard could not be removed"
LangString pbRemoveFailedText ${LANG_ENGLISH} "Quit Pinboard, then try again."
LangString pbRemoveFailed ${LANG_ENGLISH} "Pinboard could not be removed. Quit the app and try again. If it still fails, remove Pinboard from Installed apps in Windows Settings."
LangString pbRemoveRunning ${LANG_ENGLISH} "Pinboard is still running.$\r$\n$\r$\nQuit it from the tray menu, then select Uninstall again. This wizard never force-closes the app."
LangString pbPreflightFailed ${LANG_ENGLISH} "Removal stopped because Windows could not report whether Pinboard is running.$\r$\n$\r$\nQuit Pinboard and try again. Nothing was changed."
LangString pbMissingTitle ${LANG_ENGLISH} "Pinboard is not installed"
LangString pbMissingText ${LANG_ENGLISH} "There is no Pinboard installation for this Windows account.$\r$\n$\r$\nThe portable Pinboard.exe needs no uninstalling; delete the file if you no longer use it.$\r$\n$\r$\nNothing was changed."
LangString pbClose ${LANG_ENGLISH} "Close"
LangString pbRemoveDetail ${LANG_ENGLISH} "Running the registered Pinboard uninstaller."
LangString pbRemovePreserved ${LANG_ENGLISH} "Done. Notes, settings and sync data were kept."
!endif
